package pages

import (
	"strconv"
	"workshop/internal/domain/sighting"
	"workshop/web/views/components"
	"workshop/web/views/layout"
)

type HomeProps struct {
	Sightings []sighting.Sighting
	Summary   sighting.Summary
}

templ Home(props HomeProps) {
	@layout.Base(layout.BaseProps{
		Title:       "Kawaii Critters · wild animal sightings",
		Description: "Cute wild animals spotted by real people around the world.",
	}) {
		<section class="hero" id="search" aria-labelledby="hero-title">
			<span class="hero__spark hero__spark--1" aria-hidden="true">♥</span>
			<span class="hero__spark hero__spark--2" aria-hidden="true">✦</span>
			<span class="hero__spark hero__spark--3" aria-hidden="true">♥</span>
			<p class="hero__kicker">Hello, critter spotter!</p>
			<h1 id="hero-title" class="hero__title">Find the cutest wild animals<br/> seen around the world</h1>
			if len(props.Sightings) > 0 {
				<ul class="stats" aria-label="At a glance">
					<li class="stats__item stats__item--sky"><strong>{ thousands(props.Summary.Sightings) }</strong> sightings</li>
					<li class="stats__item stats__item--peach"><strong>{ strconv.Itoa(props.Summary.Species) }</strong> species</li>
					<li class="stats__item stats__item--mint"><strong>{ strconv.Itoa(props.Summary.Countries) }</strong> countries</li>
				</ul>
				@components.Filter(components.FilterProps{
					Target: "sightings",
					Empty:  "no-matches",
					Search: true,
					Groups: []components.FilterGroup{
						{Key: "animal", Label: "Animals", Options: components.FilterOptions(props.Sightings, 12, components.Animal)},
						{Key: "country", Label: "Countries", Options: components.FilterOptions(props.Sightings, 12, components.Country)},
					},
				})
			}
		</section>
		<section class="critters" aria-labelledby="critters-title">
			<h2 id="critters-title" class="section-title">Latest critters</h2>
			if len(props.Sightings) == 0 {
				<div class="empty">
					<img src="/assets/images/logo.svg" alt="" width="80" height="80"/>
					<p>No critters spotted yet. Check back soon!</p>
				</div>
			} else {
				@components.CardIcons()
				<ul id="sightings" class="sightings">
					for _, s := range props.Sightings {
						<li { components.FilterAttrs(s)... }>
							@components.SightingCard(s)
						</li>
					}
				</ul>
				<div id="no-matches" class="empty" hidden>
					<img src="/assets/images/logo.svg" alt="" width="80" height="80"/>
					<p>No critters match that. Try another word, or clear the filters.</p>
				</div>
			}
		</section>
	}
}
