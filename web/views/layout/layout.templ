package layout

import "workshop/web/views/components"

type BaseProps struct {
	Title       string
	Description string
}

templ Base(props BaseProps) {
	<!DOCTYPE html>
	<html lang="en-GB">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<link rel="icon" href="/assets/images/logo.svg" type="image/svg+xml"/>
			<link rel="manifest" href="/assets/manifest.json"/>
			<meta name="theme-color" content="#5DBB7A"/>
			<script>document.documentElement.classList.add('js')</script>
			<title>{ props.Title }</title>
			if props.Description != "" {
				<meta name="description" content={ props.Description }/>
			}
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
			<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:ital,wght@0,400;0,600;0,700;1,400&display=swap"/>
			<link rel="stylesheet" href="/assets/css/app.css"/>
			<link rel="stylesheet" href="/assets/css/filter.css"/>
			<link rel="stylesheet" href="/assets/css/lightbox.css"/>
		</head>
		<body>
			@components.Loader()
			<a class="skip" href="#sightings">Skip to the critters</a>
			<header class="site-header">
				<div class="site-header__inner">
					<a class="logo" href="/">
						<img src="/assets/images/logo.svg" alt="" width="44" height="44"/>
						<span class="logo__name">Kawaii Critters</span>
					</a>
					<nav class="nav" aria-label="Main">
						<a href="/#search">Search</a>
						<a href="/#sightings">Critters</a>
						<a href="/#about">About</a>
						<button class="stickers" type="button" aria-pressed="false" data-stickers hidden>
							<span aria-hidden="true">♥</span>
							<span class="stickers__label">My stickers</span>
							<span class="stickers__count" data-sticker-count>0</span>
						</button>
					</nav>
				</div>
			</header>
			<main class="container">
				{ children... }
			</main>
			<footer class="site-footer" id="about">
				<div class="container">
					<p class="site-footer__title">
						<img src="/assets/images/logo.svg" alt="" width="28" height="28"/>
						Kawaii Critters
					</p>
					<p>
						Wild animals spotted by real people around the world, from the
						<a href="https://www.gbif.org" rel="noopener">Global Biodiversity Information Facility</a>.
						Click any photo to see it big, with the name of the person who took it.
					</p>
					<p class="site-footer__small">Made with Go, templ and a lot of hearts ♥</p>
				</div>
			</footer>
			@components.Lightbox()
			<script src="/assets/js/filter.js" defer></script>
			<script src="/assets/js/pixel.js" defer></script>
			<script src="/assets/js/lightbox.js" defer></script>
			<script src="/assets/js/app.js" defer></script>
			<script src="/assets/js/stickers.js" defer></script>
		</body>
	</html>
}
