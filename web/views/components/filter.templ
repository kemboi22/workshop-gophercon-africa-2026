package components

import "workshop/internal/domain/sighting"

type FilterProps struct {
	Target string
	Empty  string
	Search bool
	Groups []FilterGroup
}

type FilterGroup struct {
	Key     string
	Label   string
	Options []sighting.Tally
	Flags   map[string]string
}

templ Filter(props FilterProps) {
	<form class="filter" data-filter={ props.Target } data-filter-empty={ props.Empty } role="search" hidden>
		if props.Search {
			<label class="filter__search">
				<span class="visually-hidden">Search sightings</span>
				<svg class="filter__glass" viewBox="0 0 24 24" aria-hidden="true">
					<circle cx="11" cy="11" r="7"></circle>
					<path d="M20 20l-4-4"></path>
				</svg>
				<input type="search" name="q" placeholder="Search a critter, a place or a spotter…" autocomplete="off"/>
			</label>
		}
		for _, g := range props.Groups {
			<fieldset class="filter__group">
				<legend class="visually-hidden">{ g.Label }</legend>
				<div class="filter__chips">
					for _, o := range g.Options {
						<label
							class={ "chip", templ.KV(kindClass(o.Name), g.Key == "kind") }
						>
							<input type="checkbox" name={ g.Key } value={ o.Name }/>
							if f := g.Flags[o.Name]; f != "" {
								<img class="flag" src={ f } alt="" width="20" height="15" loading="lazy"/>
							}
							{ o.Name } <small>{ o.Count }</small>
						</label>
					}
				</div>
			</fieldset>
		}
		<p class="filter__status">
			<span class="filter__sniff">
				@RunningFox("runner--small")
				<span>Sniffing…</span>
			</span>
			<output class="filter__count" aria-live="polite"></output>
			<button type="reset">Clear all</button>
		</p>
	</form>
}
