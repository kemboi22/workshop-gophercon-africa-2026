package components

templ Lightbox() {
	<dialog id="lightbox" class="lightbox" aria-labelledby="lightbox-name">
		<form method="dialog">
			<button class="lightbox__close" aria-label="Close">×</button>
		</form>
		<div class="lightbox__panel">
			<div class="lightbox__stage">
				<img class="lightbox__image" alt=""/>
				<canvas class="lightbox__pixels" aria-hidden="true"></canvas>
				<div class="lightbox__nophoto" hidden>
					<img src="/assets/images/logo.svg" alt="" width="120" height="120"/>
					<p>No photo of this one yet</p>
				</div>
				@RunningFox("lightbox__runner")
			</div>
			<div class="lightbox__info">
				<p class="lightbox__number"></p>
				<div class="lightbox__tags"></div>
				<h2 id="lightbox-name" class="lightbox__name"></h2>
				<p class="lightbox__latin"></p>
				<div class="lightbox__facts"></div>
				<p class="lightbox__credit" hidden></p>
				<a class="button lightbox__ref" target="_blank" rel="noopener" hidden>See the record ↗</a>
				<div class="lightbox__nav">
					<button type="button" data-step="-1" aria-label="Previous critter">←</button>
					<button type="button" data-step="1" aria-label="Next critter">→</button>
				</div>
			</div>
		</div>
	</dialog>
}
