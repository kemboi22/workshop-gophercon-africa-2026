package components

import (
	"strconv"
	"workshop/internal/domain/sighting"
)

templ SightingCard(s sighting.Sighting) {
	<article
		class="card"
		data-key={ strconv.FormatInt(s.GBIFKey, 10) }
		if s.ReferenceURL != "" {
			data-ref={ s.ReferenceURL }
		}
	>
		<div class="card__photo">
			if m, ok := cover(s.Media); ok {
				<a class="card__zoom" href={ templ.URL(photo(m.URL, "large")) } data-lightbox data-credit={ m.Creator }>
					<img src={ photo(m.URL, "small") } alt={ altText(s, m) } loading="lazy" decoding="async" data-pixel/>
				</a>
			} else {
				<button class="card__zoom card__nophoto" type="button" data-lightbox>
					<img src="/assets/images/logo.svg" alt="" width="64" height="64" loading="lazy"/>
					<span class="visually-hidden">Open { displayName(s.Species) }, no photo</span>
				</button>
			}
			if s.IndividualCount != nil && *s.IndividualCount > 1 {
				<span class="card__badge">×{ *s.IndividualCount }</span>
			}
			<button class="card__heart" type="button" aria-pressed="false" aria-label={ "Collect the " + displayName(s.Species) + " sticker" }>♥</button>
			@Tags(s)
		</div>
		<div class="card__body">
			<h3 class="card__name">{ displayName(s.Species) }</h3>
			if latinName(s.Species) != "" {
				<p class="card__scientific">{ latinName(s.Species) }</p>
			}
			<ul class="card__meta">
				<li>
					@icon("#i-pin")
					<span><span class="visually-hidden">Where: </span>{ localPlace(s.Location) }</span>
				</li>
				<li>
					@icon("#i-date")
					<span>
						<span class="visually-hidden">Seen: </span>
						<time datetime={ s.HappenedAt.Format("2006-01-02") }>{ s.HappenedAt.Format("2 Jan 2006") }</time>
					</span>
				</li>
				if s.RecordedBy != "" {
					<li>
						@icon("#i-heart")
						<span><span class="visually-hidden">Spotted by: </span>{ s.RecordedBy }</span>
					</li>
				}
			</ul>
		</div>
	</article>
}

templ Tags(s sighting.Sighting) {
	<div class="tags">
		if k := Kind(s); k != "" {
			<span class={ "tag", kindClass(k) }>{ k }</span>
		}
		if s.Location.Country != "" {
			<span class="tag tag--country">
				if f := flagURL(s.Location.CountryCode); f != "" {
					<img class="flag" src={ f } alt="" width="20" height="15" loading="lazy"/>
				}
				{ s.Location.Country }
			</span>
		}
	</div>
}

templ icon(id string) {
	<svg class="card__icon" aria-hidden="true"><use href={ id }></use></svg>
}

templ CardIcons() {
	<svg class="sprite" width="0" height="0" aria-hidden="true">
		<symbol id="i-pin" viewBox="0 0 24 24"><path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21zM12 12.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z"></path></symbol>
		<symbol id="i-date" viewBox="0 0 24 24"><path d="M5 6h14v14H5zM5 10h14M9 3v4M15 3v4"></path></symbol>
		<symbol id="i-heart" viewBox="0 0 24 24"><path d="M12 20s-7.5-4.6-7.5-10A4.3 4.3 0 0 1 12 7.3 4.3 4.3 0 0 1 19.5 10c0 5.4-7.5 10-7.5 10z"></path></symbol>
	</svg>
}
